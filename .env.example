# HoneyTrap Configuration
# Copy this file to .env and modify as needed

# Application
HONEYTRAP_HOST=127.0.0.1
WEB_PORT=8080
APP_NAME=HoneyTrap
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/honeytrap.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Honeypot Ports
SSH_PORT=2222
FTP_PORT=2121
TELNET_PORT=2323
DB_PORT=9090
HTTP_HONEYPOT_PORT=8081

# Detection Thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW=60
SCAN_SERVICE_THRESHOLD=3
SCAN_WINDOW=30
ANOMALY_SPIKE_THRESHOLD=15
ANOMALY_WINDOW=60

# External Services
REDIS_URL=redis://localhost:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Threat Intelligence
ABUSEIPDB_API_KEY=
OTX_API_KEY=
ENRICHMENT_CACHE_TTL=3600